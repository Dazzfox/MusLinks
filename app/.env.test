# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Doctrine ajoute déjà automatiquement le suffixe "_test" au nom de la base en environnement
# de test (config/packages/doctrine.yaml, when@test: dbname_suffix) — inutile de le remettre ici.
DATABASE_URL="mysql://symfony:azerty@database:3306/base_symfony?serverVersion=8.0&charset=utf8mb4"

# Le mailer de test ne doit jamais tenter d'envoyer réellement.
MAILER_DSN=null://null
# PIN de test dédié (424242) — surtout ne jamais réutiliser le vrai hash de prod ici,
# ce fichier est suivi par Git et le dépôt est public.
ADMIN_PIN_HASH="833dfc7e3eb11230369904322cc8481b2b9a166d965557f97d4832cd92e072af"
