{#
 # Motif zellige islamique — tessellation 8 branches
 # Grande étoile centrale + quarts d'étoile aux coins + lignes de jointure
 # Tous les espaces sont fermés par des formes géométriques (losanges, cerfs-volants)
 # Paramètres : patternId (string unique par page), opacity (float, défaut 0.22)
 #}
{% set patternId = patternId|default('star8') %}
{% set opacity   = opacity|default(0.22) %}
<div class="absolute inset-0 overflow-hidden pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" style="opacity:{{ opacity }}">
        <defs>
            <pattern id="{{ patternId }}" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">

                {# ── Grande étoile centrale (centre 30,30 — r_ext=27, r_int=13) ── #}
                {# Couvre presque toute la tuile — presque aucun espace vide #}
                <path d="M30 3 L35 18 L49 11 L42 25 L57 30 L42 35 L49 49 L35 42 L30 57 L25 42 L11 49 L18 35 L3 30 L18 25 L11 11 L25 18 Z"
                      fill="none" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>

                {# ── Losanges de connexion aux milieux des bords ── #}
                {# La moitié du losange est dans cette tuile, l'autre dans la tuile adjacente #}
                <path d="M25 0 L30 3 L35 0"   fill="none" stroke="white" stroke-width="1.2"/>
                <path d="M25 60 L30 57 L35 60" fill="none" stroke="white" stroke-width="1.2"/>
                <path d="M0 25 L3 30 L0 35"   fill="none" stroke="white" stroke-width="1.2"/>
                <path d="M60 25 L57 30 L60 35" fill="none" stroke="white" stroke-width="1.2"/>

                {# ── Lignes de jointure (cerfs-volants entre l'étoile et les losanges de bord) ── #}
                {# Ferment toutes les formes géométriques restantes — c'est la clé du zellige #}
                <line x1="25" y1="0"  x2="11" y2="11" stroke="white" stroke-width="1.2"/>
                <line x1="35" y1="0"  x2="49" y2="11" stroke="white" stroke-width="1.2"/>
                <line x1="0"  y1="25" x2="11" y2="11" stroke="white" stroke-width="1.2"/>
                <line x1="0"  y1="35" x2="11" y2="49" stroke="white" stroke-width="1.2"/>
                <line x1="25" y1="60" x2="11" y2="49" stroke="white" stroke-width="1.2"/>
                <line x1="35" y1="60" x2="49" y2="49" stroke="white" stroke-width="1.2"/>
                <line x1="60" y1="25" x2="49" y2="11" stroke="white" stroke-width="1.2"/>
                <line x1="60" y1="35" x2="49" y2="49" stroke="white" stroke-width="1.2"/>

                {# ── Quarts d'étoile aux coins (r_ext=18, r_int=8) ── #}
                {# Forment une petite étoile complète là où 4 tuiles se rejoignent #}
                <path d="M18 0 L8 3 L13 13 L3 8 L0 18"    fill="none" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>
                <path d="M42 0 L52 3 L47 13 L57 8 L60 18"  fill="none" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>
                <path d="M18 60 L8 57 L13 47 L3 52 L0 42"  fill="none" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>
                <path d="M42 60 L52 57 L47 47 L57 52 L60 42" fill="none" stroke="white" stroke-width="1.2" stroke-linejoin="round"/>

            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#{{ patternId }})"/>
    </svg>
</div>
