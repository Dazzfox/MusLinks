<script>
(function(){
    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', function() {
        if (window.scrollY > 10) {
            nav.style.boxShadow = '0 4px 20px rgba(0,0,0,0.08)';
        } else {
            nav.style.boxShadow = '0 1px 3px rgba(0,0,0,0.04)';
        }
    });

    const btn   = document.getElementById('nav-toggle');
    const menu  = document.getElementById('nav-mobile');
    const iconO = document.getElementById('nav-icon-open');
    const iconC = document.getElementById('nav-icon-close');
    if (btn) btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden');
        iconO.classList.toggle('hidden', !open);
        iconC.classList.toggle('hidden', open);
    });

    const dropBtn  = document.getElementById('pro-dropdown-btn');
    const dropMenu = document.getElementById('pro-dropdown-menu');
    const chevron  = document.getElementById('pro-dropdown-chevron');

    if (dropBtn && dropMenu) {
        dropBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const isOpen = !dropMenu.classList.contains('hidden');
            dropMenu.classList.toggle('hidden', isOpen);
            chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
            dropBtn.setAttribute('aria-expanded', String(!isOpen));
        });
        document.addEventListener('click', function() {
            dropMenu.classList.add('hidden');
            chevron.style.transform = '';
            dropBtn.setAttribute('aria-expanded', 'false');
        });
        dropMenu.addEventListener('click', function(e) { e.stopPropagation(); });
    }
})();
</script>
