{% set isEcom = professional.isEcommerce() %}
{% set colors = isEcom
    ? ['6366f1','8b5cf6','a855f7','0ea5e9','ec4899','14b8a6']
    : ['059669','0891b2','7c3aed','db2777','ea580c','65a30d'] %}
{% set bgColor = colors[professional.id % 6] %}
{% set borderColor = isEcom ? 'border-indigo-500' : 'border-emerald-600' %}
{% set shadowColor = isEcom ? 'rgba(99,102,241,0.08)' : 'rgba(5,150,105,0.08)' %}

<div class="pro-card bg-white rounded-2xl border-l-4 {{ borderColor }} shadow-sm hover:-translate-y-1 hover:shadow-lg transition-all duration-300 overflow-hidden flex flex-col"
     style="box-shadow: 0 2px 12px {{ shadowColor }};">

    <div class="p-5 flex-1">
        <div class="flex items-start gap-3 mb-3">
            {% if professional.imageName %}
                <img src="/uploads/professionals/{{ professional.imageName }}"
                     alt="{{ professional.nomSociete }}"
                     class="w-14 h-14 rounded-xl object-cover flex-shrink-0">
            {% else %}
                <div class="w-14 h-14 rounded-xl flex items-center justify-center text-white font-serif font-bold text-lg flex-shrink-0"
                     style="background-color: #{{ bgColor }};">
                    {{ professional.getInitials() }}
                </div>
            {% endif %}

            <div class="flex-1 min-w-0">
                <h3 class="font-semibold {{ isEcom ? 'text-indigo-900' : 'text-emerald-900' }} text-sm leading-tight truncate">
                    {{ professional.nomSociete }}
                </h3>
                <p class="text-xs text-slate-500 truncate">{{ professional.profession ?? professional.domaineActivite }}</p>
                <div class="flex items-center gap-1 mt-1">
                    {% for i in 1..5 %}
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 {{ i <= professional.starsAverage ? (isEcom ? 'text-indigo-500' : 'text-emerald-600') : 'text-slate-200' }}" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    {% endfor %}
                    <span class="text-xs text-slate-500 ml-1">{{ professional.starsAverage|number_format(1) }} ({{ professional.totalAvis }})</span>
                </div>
            </div>

            <div class="flex flex-col gap-1">
                {% include 'components/_badge_statut.html.twig' with {statut: professional.statut} %}
            </div>
        </div>

        {% if isEcom %}
            {# ── E-commerce : badge + catégorie ── #}
            <div class="text-xs text-slate-600 space-y-1">
                <div class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    <span>{{ professional.domaineActivite }}</span>
                </div>
            </div>
            <div class="mt-3">
                <span class="inline-flex items-center gap-1 bg-indigo-50 text-indigo-700 text-xs font-medium px-2 py-1 rounded-full border border-indigo-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    Boutique en ligne
                </span>
            </div>
        {% else %}
            {# ── Commerce physique : adresse + SIRET ── #}
            <div class="text-xs text-slate-600 space-y-1">
                <div class="flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>{{ professional.ville }} — {{ professional.codePostal }}</span>
                </div>
                <div class="flex items-center gap-1.5 font-mono">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    <span class="text-slate-400">SIRET</span>
                    <span>{{ professional.getSiretFormatted() }}</span>
                </div>
            </div>
            {% if professional.siteEcommerce %}
            <div class="mt-3">
                <a href="{{ professional.siteEcommerce }}" target="_blank" rel="noopener"
                   class="inline-flex items-center gap-1 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-medium px-2 py-1 rounded-full border border-indigo-100 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    Boutique en ligne
                </a>
            </div>
            {% endif %}
        {% endif %}
    </div>

    <div class="px-5 pb-4">
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_professional_show', {id: professional.id}) }}"
               class="flex-1 text-center {{ isEcom ? 'bg-indigo-600 hover:bg-indigo-700' : 'bg-emerald-600 hover:bg-emerald-700' }} text-white text-xs font-medium py-2 rounded-lg transition-colors">
                Voir la fiche
            </a>
            {% if isEcom and professional.siteEcommerce %}
                <a href="{{ professional.siteEcommerce }}" target="_blank" rel="noopener"
                   class="flex-1 text-center bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-medium py-2 rounded-lg border border-indigo-200 transition-colors">
                    Visiter →
                </a>
            {% else %}
                {% if professional.telephone %}
                <a href="tel:{{ professional.telephone }}"
                   class="px-3 py-2 border border-emerald-200 hover:border-emerald-400 text-emerald-700 rounded-lg transition-colors" title="Appeler">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </a>
                {% endif %}
                {% if professional.adresseRue %}
                <a href="https://www.google.com/maps/search/?api=1&query={{ (professional.adresseRue ~ ' ' ~ professional.ville ~ ' ' ~ professional.codePostal ~ ' France')|url_encode }}"
                   target="_blank" rel="noopener"
                   class="px-3 py-2 border border-emerald-200 hover:border-emerald-400 text-emerald-700 rounded-lg transition-colors" title="Itinéraire">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
                    </svg>
                </a>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
