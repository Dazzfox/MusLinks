{#
 # Composant barre de recherche réutilisable
 # Paramètres : formAction (string), showGps (bool), compact (bool)
 #}
{% set formAction = formAction|default(path('app_search')) %}
{% set showGps = showGps|default(true) %}
{% set compact = compact|default(false) %}

<form action="{{ formAction }}" method="GET" id="search-bar-form"
      class="{{ compact ? 'flex gap-2' : 'bg-white rounded-2xl shadow-xl p-2 flex flex-col sm:flex-row gap-2' }}">

    <div class="flex-1 relative">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="h-5 w-5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text"
               name="q"
               id="searchbar-q"
               value="{{ query|default('') }}"
               placeholder="{{ metierPlaceholder|default('Médecin, avocat, plombier…') }}"
               class="w-full pl-10 pr-4 py-3 rounded-xl border border-transparent focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 outline-none text-sm text-slate-800">
    </div>

    <div class="flex-1 relative">
        <svg xmlns="http://www.w3.org/2000/svg"
             class="h-5 w-5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <input type="text"
               name="ville"
               id="searchbar-ville"
               value="{{ ville|default('') }}"
               placeholder="{{ villePlaceholder|default('Ville ou code postal…') }}"
               class="w-full pl-10 {{ showGps ? 'pr-10' : 'pr-4' }} py-3 rounded-xl border border-transparent focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100 outline-none text-sm text-slate-800">
        {% if showGps %}
            <button type="button"
                    onclick="geolocate('searchbar-ville')"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-emerald-600 hover:text-emerald-800 transition-colors"
                    title="Utiliser ma position GPS">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z"/>
                </svg>
            </button>
        {% endif %}
    </div>

    <button type="submit"
            class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-medium px-6 py-3 rounded-xl transition-all whitespace-nowrap">
        {{ submitLabel|default('Rechercher') }}
    </button>
</form>
