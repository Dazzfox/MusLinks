{% extends 'base.html.twig' %}

{% block title %}Contact — MusLinks{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%);" class="relative overflow-hidden py-16 px-4 text-center">
    {% include 'components/_islamic_pattern.html.twig' with {patternId: 'star8-contact'} %}
    <h1 class="relative font-serif text-4xl font-bold text-white mb-3">Contactez-nous</h1>
    <p class="text-white/80">Une question ? Nous sommes là pour vous aider.</p>
</div>

<div class="max-w-xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm">
        <form method="POST" action="{{ path('app_contact') }}" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Votre nom</label>
                <input type="text" name="nom" required placeholder="Prénom Nom"
                       class="w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Votre email</label>
                <input type="email" name="email" required placeholder="vous@exemple.fr"
                       class="w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Sujet</label>
                <select name="sujet" class="w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white">
                    <option value="question">Question générale</option>
                    <option value="inscription">Inscription professionnelle</option>
                    <option value="signalement">Signalement</option>
                    <option value="partenariat">Partenariat</option>
                    <option value="autre">Autre</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Message</label>
                <textarea name="message" required rows="5" placeholder="Votre message…"
                          class="w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm resize-none"></textarea>
            </div>
            <button type="submit"
                    class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl transition-colors">
                Envoyer le message
            </button>
        </form>
    </div>
    <p class="text-center text-xs text-slate-400 mt-4">Réponse sous 24–48h · <a href="mailto:{{ contact_email }}" class="hover:text-emerald-600 transition-colors">{{ contact_email }}</a></p>
</div>

{% endblock %}
