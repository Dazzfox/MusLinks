{% extends 'base.html.twig' %}

{% block title %}Modifier ma fiche — MusLinks{% endblock %}

{% block body %}
<div class="relative overflow-hidden py-10 px-4" style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%);">
    {% include 'components/_islamic_pattern.html.twig' with {patternId: 'star8-pro-edit'} %}
    <div class="relative max-w-3xl mx-auto flex items-center justify-between">
        <div>
            <a href="{{ path('pro_dashboard') }}" class="inline-flex items-center gap-1.5 text-white/70 hover:text-white text-sm mb-2 transition-colors">
                ← Retour au tableau de bord
            </a>
            <h1 class="font-serif text-2xl font-bold text-white">Modifier mes informations</h1>
            <p class="text-white/70 text-sm mt-1">{{ professional.nomSociete }}</p>
        </div>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    {% for msg in app.flashes('success') %}
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm px-4 py-3 rounded-xl mb-6">✓ {{ msg }}</div>
    {% endfor %}

    {{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

    {# ── Société ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-lg font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">1</span>
            Société & Activité
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="sm:col-span-2">
                {{ form_label(form.nomSociete, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.nomSociete, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.nomSociete) }}
            </div>
            <div>
                {{ form_label(form.prenomResponsable, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.prenomResponsable, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.prenomResponsable) }}
            </div>
            <div>
                {{ form_label(form.nomResponsable, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.nomResponsable, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.nomResponsable) }}
            </div>
            <div>
                {{ form_label(form.domaineActivite, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.domaineActivite, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white'}}) }}
                {{ form_errors(form.domaineActivite) }}
            </div>
            <div>
                {{ form_label(form.profession, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.profession, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.profession) }}
            </div>
            <div>
                {{ form_label(form.genre, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.genre, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white'}}) }}
            </div>
        </div>
    </div>

    {# ── Contact & Web ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-lg font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">2</span>
            Contact & Présence en ligne
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                {{ form_label(form.telephone, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.telephone, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.telephone) }}
            </div>
            <div>
                {{ form_label(form.siteWeb, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.siteWeb, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.siteWeb) }}
            </div>
            <div class="sm:col-span-2">
                <div class="flex items-center gap-2 mb-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    {{ form_label(form.siteEcommerce, null, {label_attr: {class: 'text-sm font-medium text-slate-700'}}) }}
                </div>
                {{ form_widget(form.siteEcommerce, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-indigo-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100 outline-none text-sm'}}) }}
                {{ form_errors(form.siteEcommerce) }}
            </div>
            <div class="sm:col-span-2">
                {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.description, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm', rows: 5}}) }}
            </div>
        </div>
    </div>

    {# ── Photo ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-lg font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">3</span>
            Photo / Logo <span class="text-sm font-normal text-slate-400 ml-1">(facultatif)</span>
        </h2>
        {% if professional.imageName %}
            <div class="flex items-center gap-4 mb-4">
                <img src="/uploads/professionals/{{ professional.imageName }}" class="w-20 h-20 rounded-xl object-cover border border-emerald-100">
                <p class="text-sm text-slate-500">Photo actuelle. Uploadez-en une nouvelle pour la remplacer.</p>
            </div>
        {% endif %}
        {{ form_widget(form.imageFile) }}
    </div>

    <div class="flex gap-3">
        <button type="submit"
                class="flex-1 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-semibold py-3.5 rounded-xl transition-all">
            Enregistrer les modifications
        </button>
        <a href="{{ path('pro_dashboard') }}"
           class="px-6 py-3.5 border border-emerald-200 hover:border-emerald-400 text-emerald-700 font-medium rounded-xl transition-colors">
            Annuler
        </a>
    </div>

    {{ form_end(form) }}

    <p class="text-center text-xs text-slate-400 mt-4">
        Pour modifier votre email, adresse ou SIRET, <a href="{{ path('app_contact') }}" class="text-emerald-600 hover:underline">contactez l'équipe MusLinks</a>.
    </p>
</div>
{% endblock %}
