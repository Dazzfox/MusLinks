{# ── CTA FINALE ── #}
<section style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%);" class="relative overflow-hidden py-20">
    {% include 'components/_islamic_pattern.html.twig' with {patternId: 'star8-cta'} %}
    <div class="relative max-w-3xl mx-auto px-4 text-center">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-4">
