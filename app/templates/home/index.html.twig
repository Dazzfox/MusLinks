    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Geolocation helper
        function geolocate(inputId) {
            if (!navigator.geolocation) return;
            var btn = document.querySelector('[onclick="geolocate(\'' + inputId + '\')"]');
            if (btn) btn.classList.add('animate-spin');
            navigator.geolocation.getCurrentPosition(
                function(pos) {
                    if (btn) btn.classList.remove('animate-spin');
                    fetch('https://nominatim.openstreetmap.org/reverse?lat=' + pos.coords.latitude + '&lon=' + pos.coords.longitude + '&format=json&accept-language=fr')
                        .then(function(r) { return r.json(); })
                        .then(function(d) {
                            var cp = d.address.postcode || '';
                            var city = d.address.city || d.address.town || d.address.village || '';
                            var val = cp || city;
                            document.getElementById(inputId).value = val;
                            // Variante desktop/mobile du même champ (voir sync plus bas) : on la
                            // remplit aussi directement, un .value JS ne déclenche pas 'input'.
                            var mirror = document.getElementById(inputId + '-mobile');
                            if (mirror) mirror.value = val;
                        })
                        .catch(function() { if (btn) btn.classList.remove('animate-spin'); });
                },
                function() { if (btn) btn.classList.remove('animate-spin'); }
            );
        }

        // Autocomplete
        var suggestUrl = '{{ path("api_suggestions") }}';
        var acTimer = null;

        function setupAutocomplete(inputId, dropdownId, field) {
            var input = document.getElementById(inputId);
            var dropdown = document.getElementById(dropdownId);
            if (!input || !dropdown) return;

            input.addEventListener('input', function() {
                clearTimeout(acTimer);
                var val = input.value.trim();
                if (val.length < 2) { dropdown.classList.add('hidden'); return; }
                acTimer = setTimeout(function() {
                    var params = new URLSearchParams();
                    params.set(field, val);
                    fetch(suggestUrl + '?' + params.toString())
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            var items = field === 'q' ? (data.professions || []) : (data.villes || []);
                            if (!items.length) { dropdown.classList.add('hidden'); return; }
                            dropdown.innerHTML = '';
                            items.forEach(function(s) {
                                var btn = document.createElement('button');
                                btn.type = 'button';
                                btn.textContent = s;
                                btn.style.cssText = 'display:block;width:100%;padding:0.5rem 1rem;text-align:left;font-size:0.875rem;color:#1e293b;background:none;border:none;border-bottom:1px solid #f0fdf4;cursor:pointer;font-family:inherit;';
                                btn.addEventListener('mousedown', function(e) {
                                    e.preventDefault();
                                    input.value = field === 'ville' ? s.split(' (')[0] : s;
                                    dropdown.classList.add('hidden');
                                });
                                btn.addEventListener('mouseenter', function() { btn.style.background = '#ecfdf5'; btn.style.color = '#059669'; });
                                btn.addEventListener('mouseleave', function() { btn.style.background = 'none'; btn.style.color = '#1e293b'; });
                                dropdown.appendChild(btn);
                            });
                            dropdown.classList.remove('hidden');
                        })
                        .catch(function() { dropdown.classList.add('hidden'); });
                }, 250);
            });

            input.addEventListener('blur', function() {
                setTimeout(function() { dropdown.classList.add('hidden'); }, 200);
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            setupAutocomplete('home-q', 'home-q-dropdown', 'q');
            setupAutocomplete('home-ville', 'home-ville-dropdown', 'ville');

            // Pré-sélection pays par langue/timezone navigateur
            var supported = ['FR','BE','CA','CH','LU','MA','DZ','TN','LB'];
            var lang = (navigator.language || '').toUpperCase().split('-')[1] || '';
            var tzMap = {
                'Europe/Paris':'FR','Europe/Brussels':'BE',
                'America/Toronto':'CA','America/Montreal':'CA','America/Vancouver':'CA',
                'Europe/Zurich':'CH','Europe/Luxembourg':'LU',
                'Africa/Casablanca':'MA','Africa/Algiers':'DZ',
                'Africa/Tunis':'TN','Asia/Beirut':'LB'
            };
            var detected = (supported.includes(lang) ? lang : null)
                || tzMap[Intl.DateTimeFormat().resolvedOptions().timeZone]
                || '';

            // pays/q/ville existent chacun en double dans le DOM (variante desktop + mobile,
            // seul l'affichage CSS change selon la largeur d'écran) : les deux exemplaires sont
            // soumis au submit du formulaire, donc ils doivent toujours rester synchronisés,
            // sinon celui resté sur sa valeur par défaut écrase le choix de l'utilisateur.
            function syncTwins(idA, idB, eventName) {
                var a = document.getElementById(idA);
                var b = document.getElementById(idB);
                if (!a || !b) return;
                a.addEventListener(eventName, function() { b.value = this.value; });
                b.addEventListener(eventName, function() { a.value = this.value; });
            }

            var paysDesktop = document.getElementById('home-pays');
            var paysMobile  = document.getElementById('home-pays-mobile');
            if (detected) {
                if (paysDesktop) paysDesktop.value = detected;
                if (paysMobile)  paysMobile.value = detected;
            }
            syncTwins('home-pays', 'home-pays-mobile', 'change');
            syncTwins('home-q', 'home-q-mobile', 'input');
            syncTwins('home-ville', 'home-ville-mobile', 'input');
        });

        // Counter animation
        document.addEventListener('DOMContentLoaded', function() {
            var counters = document.querySelectorAll('.counter');
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (!entry.isIntersecting) return;
                    var el = entry.target;
                    var target = parseInt(el.dataset.target, 10);
                    var duration = 1500;
                    var step = target / (duration / 16);
                    var current = 0;
                    var timer = setInterval(function() {
                        current += step;
                        if (current >= target) {
                            current = target;
                            clearInterval(timer);
                        }
                        el.textContent = Math.round(current);
                    }, 16);
                    observer.unobserve(el);
                });
            }, { threshold: 0.3 });
            counters.forEach(function(c) { observer.observe(c); });
        });
    </script>
{% endblock %}
