{% extends 'base.html.twig' %}

{% block title %}Inscrire ma société — MusLinks{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%);" class="relative overflow-hidden py-12 px-4">
    {% include 'components/_islamic_pattern.html.twig' with {patternId: 'star8-register'} %}
    <div class="relative max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-white/15 text-white text-sm font-medium px-4 py-2 rounded-full mb-4">
            Inscription gratuite, soutenu par la communauté
        </div>
        <h1 class="font-serif text-2xl sm:text-4xl font-bold text-white mb-3">Inscrivez votre société</h1>
        <p class="text-white/80">Rejoignez le réseau des professionnels de confiance. Fiche active sous 48h.</p>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">

    {% if app.request.method == 'POST' and not form.vars.valid %}
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-8">
            <h3 class="font-semibold text-red-800 mb-2">Veuillez corriger les erreurs suivantes :</h3>
            <ul class="list-disc list-inside space-y-1 text-sm text-red-700">
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
                {% for child in form %}
                    {% for error in child.vars.errors %}
                        <li><strong>{{ child.vars.label }}</strong> : {{ error.message }}</li>
                    {% endfor %}
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {{ form_start(form, {attr: {id: 'register-form', class: 'space-y-8', novalidate: 'novalidate'}}) }}

    {# ── SECTION SOCIÉTÉ ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-xl font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">1</span>
            Informations de la société
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            {# Pays #}
            <div class="sm:col-span-2">
                {{ form_label(form.pays, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.pays, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white'}}) }}
                {{ form_errors(form.pays) }}
            </div>

            <div class="sm:col-span-2">
                {{ form_label(form.nomSociete, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.nomSociete, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.nomSociete) }}
            </div>
            <div>
                {{ form_label(form.prenomResponsable, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.prenomResponsable, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.prenomResponsable) }}
            </div>
            <div>
                {{ form_label(form.nomResponsable, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.nomResponsable, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.nomResponsable) }}
            </div>
            <div>
                {{ form_label(form.genre, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.genre, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white'}}) }}
                {{ form_errors(form.genre) }}
            </div>
            <div>
                {{ form_label(form.domaineActivite, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.domaineActivite, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm bg-white'}}) }}
                {{ form_errors(form.domaineActivite) }}
            </div>
            <div class="sm:col-span-2">
                {{ form_label(form.profession, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.profession, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.profession) }}
            </div>

            {# Numéro d'entreprise (label dynamique selon pays) #}
            <div class="sm:col-span-2">
                <label id="siret-label" class="block text-sm font-medium text-slate-700 mb-1">
                    Numéro SIRET (14 chiffres) *
                </label>
                {{ form_widget(form.siret, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm font-mono tracking-widest', inputmode: 'numeric'}}) }}
                <p id="siret-preview" class="text-xs text-emerald-600 mt-1 font-mono hidden"></p>
                <p id="siret-hint" class="text-xs text-slate-400 mt-1">Sera vérifié dans le registre national des entreprises.</p>
                {{ form_errors(form.siret) }}
            </div>
        </div>
    </div>

    {# ── SECTION CONTACT ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-xl font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">2</span>
            Coordonnées
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="sm:col-span-2">
                {{ form_label(form.adresseRue, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.adresseRue, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.adresseRue) }}
            </div>
            <div>
                {{ form_label(form.codePostal, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.codePostal, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm', inputmode: 'numeric'}}) }}
                {{ form_errors(form.codePostal) }}
            </div>
            <div>
                {{ form_label(form.ville, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.ville, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.ville) }}
            </div>

            {# Téléphone avec indicatif #}
            <div>
                {{ form_label(form.telephone, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                <div class="flex rounded-xl border border-emerald-200 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-100 overflow-hidden">
                    <div id="phone-prefix"
                         class="flex items-center px-3 py-2.5 bg-emerald-50 border-r border-emerald-200 text-sm font-semibold text-emerald-800 whitespace-nowrap select-none">
                        🇫🇷 +33
                    </div>
                    {{ form_widget(form.telephone, {attr: {class: 'flex-1 px-3 py-2.5 outline-none text-sm bg-white', placeholder: '6 00 00 00 00'}}) }}
                </div>
                {{ form_errors(form.telephone) }}
            </div>

            <div>
                {{ form_label(form.email, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.email, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.email) }}
            </div>
            <div>
                {{ form_label(form.siteWeb, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.siteWeb, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm'}}) }}
                {{ form_errors(form.siteWeb) }}
            </div>

            {# ── E-commerce toggle ── #}
            <div class="sm:col-span-2">
                <label class="flex items-center gap-3 cursor-pointer select-none group">
                    <div class="relative">
                        <input type="checkbox" id="has-ecommerce-toggle" class="sr-only peer"
                               {{ form.siteEcommerce.vars.value ? 'checked' : '' }}>
                        <div class="w-10 h-6 bg-slate-200 peer-checked:bg-emerald-500 rounded-full transition-colors"></div>
                        <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4"></div>
                    </div>
                    <span class="text-sm font-medium text-slate-700 group-hover:text-emerald-700 transition-colors">
                        J'ai aussi une boutique en ligne (e-commerce)
                    </span>
                </label>

                <div id="ecommerce-field" class="{{ form.siteEcommerce.vars.value ? '' : 'hidden' }} mt-3">
                    <div class="flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                        <div class="flex-1">
                            {{ form_widget(form.siteEcommerce, {attr: {
                                class: 'w-full bg-transparent outline-none text-sm text-slate-700 placeholder-slate-400',
                                id: 'site-ecommerce-input'
                            }}) }}
                        </div>
                    </div>
                    {{ form_errors(form.siteEcommerce) }}
                </div>
            </div>
            <div class="sm:col-span-2">
                {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-slate-700 mb-1'}}) }}
                {{ form_widget(form.description, {attr: {class: 'w-full px-4 py-2.5 rounded-xl border border-emerald-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none text-sm', rows: 4}}) }}
            </div>
        </div>
    </div>

    {# ── SECTION PHOTO ── #}
    <div class="bg-white rounded-2xl p-6 shadow-sm">
        <h2 class="font-serif text-xl font-bold text-emerald-900 mb-5 flex items-center gap-2">
            <span class="w-7 h-7 bg-emerald-100 text-emerald-700 rounded-lg flex items-center justify-center text-sm font-bold">3</span>
            Photo / Logo <span class="text-sm font-normal text-slate-400 ml-1">(facultatif)</span>
        </h2>
        {{ form_widget(form.imageFile) }}
    </div>

    {{ form_widget(form.latitude) }}
    {{ form_widget(form.longitude) }}

    <button type="submit"
            class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-lg py-4 rounded-2xl transition-colors active:scale-95 shadow-lg">
        Soumettre ma demande d'inscription
    </button>
    <p class="text-center text-xs text-slate-400 mt-2">Votre fiche sera examinée et publiée sous 48h ouvrées.</p>

    {{ form_widget(form._token) }}
    {{ form_end(form, {render_rest: false}) }}
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        var countryData = {
            FR: { flag: '🇫🇷', code: '+33',  numLabel: 'Numéro SIRET (14 chiffres) *',              numPlaceholder: '00000000000000',  numHint: 'Sera vérifié dans le registre national des entreprises.', phonePh: '6 00 00 00 00'  },
            BE: { flag: '🇧🇪', code: '+32',  numLabel: 'Numéro BCE (facultatif)',                   numPlaceholder: '0123456789',      numHint: 'Numéro d\'entreprise belge — facultatif.', phonePh: '4 70 00 00 00'  },
            CA: { flag: '🇨🇦', code: '+1',   numLabel: 'Numéro d\'entreprise / NEQ (facultatif)',   numPlaceholder: '0000000000',      numHint: 'NEQ ou numéro fédéral — facultatif.', phonePh: '418 000-0000'    },
            CH: { flag: '🇨🇭', code: '+41',  numLabel: 'IDE / UID (facultatif)',                    numPlaceholder: 'CHE-000.000.000', numHint: 'Numéro IDE suisse — facultatif.', phonePh: '79 000 00 00'    },
            LU: { flag: '🇱🇺', code: '+352', numLabel: 'Numéro RCS (facultatif)',                   numPlaceholder: 'B123456',         numHint: 'Registre de Commerce du Luxembourg — facultatif.', phonePh: '691 000 000'     },
            MA: { flag: '🇲🇦', code: '+212', numLabel: 'ICE / Registre du commerce (facultatif)',   numPlaceholder: '',                numHint: 'Facultatif.', phonePh: '6 00 00 00 00'  },
            DZ: { flag: '🇩🇿', code: '+213', numLabel: 'NIF / Registre du commerce (facultatif)',   numPlaceholder: '',                numHint: 'Facultatif.', phonePh: '6 00 00 00 00'  },
            TN: { flag: '🇹🇳', code: '+216', numLabel: 'Matricule fiscal (facultatif)',              numPlaceholder: '',                numHint: 'Facultatif.', phonePh: '9 000 0000'      },
            LB: { flag: '🇱🇧', code: '+961', numLabel: 'Numéro de registre commercial (facultatif)',numPlaceholder: '',                numHint: 'Facultatif.', phonePh: '71 000 000'      },
        };

        var paysSelect   = document.getElementById('{{ form.pays.vars.id }}');
        var phonePrefix  = document.getElementById('phone-prefix');
        var phoneInput   = document.getElementById('{{ form.telephone.vars.id }}');
        var siretLabel   = document.getElementById('siret-label');
        var siretInput   = document.getElementById('{{ form.siret.vars.id }}');
        var siretPreview = document.getElementById('siret-preview');
        var siretHint    = document.getElementById('siret-hint');

        function updateForCountry(code) {
            var d = countryData[code] || countryData['FR'];
            if (phonePrefix) phonePrefix.textContent = d.flag + ' ' + d.code;
            if (phoneInput)  phoneInput.setAttribute('placeholder', d.phonePh);
            if (siretLabel)  siretLabel.textContent = d.numLabel;
            if (siretInput) {
                siretInput.setAttribute('placeholder', d.numPlaceholder);
                siretInput.setAttribute('maxlength', code === 'FR' ? 14 : 20);
                siretInput.setAttribute('inputmode', code === 'FR' ? 'numeric' : 'text');
            }
            if (siretHint)    siretHint.textContent = d.numHint;
            if (siretPreview) siretPreview.classList.add('hidden');
        }

        if (paysSelect) {
            updateForCountry(paysSelect.value);
            paysSelect.addEventListener('change', function () {
                updateForCountry(this.value);
                if (siretInput) siretInput.value = '';
            });
        }

        // Formateur SIRET (France uniquement)
        if (siretInput) {
            siretInput.addEventListener('input', function () {
                if (!paysSelect || paysSelect.value !== 'FR') return;
                var val = this.value.replace(/\D/g, '').slice(0, 14);
                this.value = val;
                if (val.length === 14) {
                    siretPreview.textContent = val.slice(0,3)+' '+val.slice(3,6)+' '+val.slice(6,9)+' '+val.slice(9);
                    siretPreview.classList.remove('hidden');
                } else {
                    siretPreview.classList.add('hidden');
                }
            });
        }

        // Toggle e-commerce field
        var ecomToggle = document.getElementById('has-ecommerce-toggle');
        var ecomField  = document.getElementById('ecommerce-field');
        var ecomInput  = document.getElementById('site-ecommerce-input');
        if (ecomToggle) {
            ecomToggle.addEventListener('change', function () {
                if (this.checked) {
                    ecomField.classList.remove('hidden');
                    if (ecomInput) ecomInput.focus();
                } else {
                    ecomField.classList.add('hidden');
                    if (ecomInput) ecomInput.value = '';
                }
            });
        }
    })();
    </script>
{% endblock %}
