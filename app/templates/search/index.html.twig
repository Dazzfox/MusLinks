{% extends 'base.html.twig' %}

{% block title %}Annuaire des professionnels — MusLinks{% endblock %}

{% block body %}

<div style="background: linear-gradient(135deg, #064E3B 0%, #059669 100%);" class="relative overflow-hidden py-10 px-4">
    {% include 'components/_islamic_pattern.html.twig' with {patternId: 'star8-search'} %}
    <div class="relative max-w-4xl mx-auto">
        <h1 class="font-serif text-3xl font-bold text-white mb-8 text-center">Trouvez votre professionnel</h1>
        <form id="search-form" autocomplete="off">

            {# ── Desktop : barre unifiée pill ── #}
            <div class="hidden sm:flex items-stretch bg-white rounded-full shadow-2xl border border-slate-100" style="min-height:62px">

                {# Pays #}
                <div class="flex items-center pl-6 pr-4 border-r border-slate-100 rounded-l-full shrink-0">
                    <select id="pays-select-bar"
                            class="outline-none text-slate-700 text-sm bg-transparent cursor-pointer appearance-none font-medium">
                        <option value="">🌍 Tous</option>
                        {# Lancement France uniquement — autres pays en réserve, cf. ProfessionalType::pays #}
                        <option value="FR">🇫🇷 France</option>
                    </select>
                </div>

                {# Métier #}
                <div class="flex-1 relative flex items-center border-r border-slate-100 hover:bg-slate-50/60 transition-colors">
                    <div class="flex flex-col justify-center px-5 w-full">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider leading-none mb-0.5">Métier</span>
                        <input type="text" id="search-q" placeholder="Médecin, avocat, boucher…" value="{{ query }}" autocomplete="off"
                               class="outline-none text-slate-800 text-sm bg-transparent placeholder-slate-300 w-full">
                    </div>
                    <div id="search-q-dropdown" class="autocomplete-dropdown hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden"></div>
                </div>

                {# Ville #}
                <div class="flex-1 relative flex items-center hover:bg-slate-50/60 transition-colors">
                    <div class="flex flex-col justify-center px-5 w-full">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider leading-none mb-0.5">Où ?</span>
                        <input type="text" id="search-ville" placeholder="Paris, Lyon, 75001…" value="{{ ville }}" autocomplete="off"
                               class="outline-none text-slate-800 text-sm bg-transparent placeholder-slate-300 w-full">
                    </div>
                    <button type="button" id="gps-btn"
                            class="mr-3 text-slate-300 hover:text-emerald-500 flex-shrink-0 transition-colors" title="Ma position">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z"/>
                        </svg>
                    </button>
                    <div id="search-ville-dropdown" class="autocomplete-dropdown hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden"></div>
                </div>

                {# Bouton Rechercher #}
                <div class="flex items-center p-2 rounded-r-full shrink-0">
                    <button type="submit"
                            class="bg-emerald-500 hover:bg-emerald-400 text-white font-semibold px-6 rounded-full shadow transition-all active:scale-95 whitespace-nowrap flex items-center justify-center gap-2 self-stretch">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        Rechercher
                    </button>
                </div>

            </div>

            {# ── Mobile : cartes empilées ── #}
            <div class="sm:hidden flex flex-col gap-3">

                <div class="bg-white/95 rounded-2xl shadow-lg flex items-center px-4">
                    <span class="text-lg mr-2 flex-shrink-0">🌍</span>
                    <select id="pays-select-bar-mobile"
                            class="flex-1 py-3.5 outline-none text-slate-800 text-sm bg-transparent cursor-pointer">
                        <option value="">Tous les pays</option>
                        {# Lancement France uniquement — autres pays en réserve, cf. ProfessionalType::pays #}
                        <option value="FR">🇫🇷 France</option>
                    </select>
                </div>

                <div class="relative bg-white/95 rounded-2xl shadow-lg flex items-center px-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 flex-shrink-0 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    <input type="text" id="search-q-mobile" placeholder="Médecin, avocat, boucher…" value="{{ query }}" autocomplete="off"
                           class="flex-1 py-3.5 outline-none text-slate-800 text-sm bg-transparent placeholder-slate-400">
                    <div id="search-q-mobile-dropdown" class="autocomplete-dropdown hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden"></div>
                </div>

                <div class="relative bg-white/95 rounded-2xl shadow-lg flex items-center px-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500 flex-shrink-0 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    </svg>
                    <input type="text" id="search-ville-mobile" placeholder="Paris, Lyon, 75001…" value="{{ ville }}" autocomplete="off"
                           class="flex-1 py-3.5 outline-none text-slate-800 text-sm bg-transparent placeholder-slate-400">
                    <button type="button" id="gps-btn-mobile"
                            class="text-emerald-500 hover:text-emerald-700 ml-2 flex-shrink-0 transition-colors" title="Ma position">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm8.94 3A8.994 8.994 0 0013 3.06V1h-2v2.06A8.994 8.994 0 003.06 11H1v2h2.06A8.994 8.994 0 0011 20.94V23h2v-2.06A8.994 8.994 0 0020.94 13H23v-2h-2.06z"/>
                        </svg>
                    </button>
                    <div id="search-ville-mobile-dropdown" class="autocomplete-dropdown hidden absolute left-0 right-0 top-full mt-2 z-50 bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden"></div>
                </div>

                <button type="submit"
                        class="w-full bg-emerald-500 hover:bg-emerald-400 text-white font-semibold py-3.5 rounded-2xl shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    Rechercher
                </button>

            </div>

        </form>
    </div>
</div>

<div class="sticky top-0 z-30 bg-white/95 backdrop-blur-sm border-b border-slate-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide">
                <button onclick="filterDomaine('')" class="domaine-chip active whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium bg-emerald-600 text-white">
                    Tous
                </button>
                {% for cat in ['Santé','Droit & Conseil','Alimentation','Bâtiment & Travaux','Informatique & Tech','Beauté & Bien-être','Éducation & Formation','Finance & Assurance','Immobilier','Mosquée & Religion'] %}
                    <button onclick="filterDomaine('{{ cat }}')"
                            class="domaine-chip whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium bg-white text-slate-600 border border-slate-200 hover:border-emerald-400 hover:text-emerald-700 transition-colors">
                        {{ cat }}
                    </button>
                {% endfor %}
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <div class="flex items-center gap-2 overflow-x-auto pb-0.5 scrollbar-hide flex-1">
                    <span class="text-xs text-slate-400 font-medium whitespace-nowrap">Type :</span>
                    <button onclick="filterType('')" id="type-chip-tous" class="type-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-emerald-600 text-white transition-colors">Tous</button>
                    <button onclick="filterType('PHYSIQUE')" id="type-chip-physique" class="type-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-emerald-400 hover:text-emerald-700 transition-colors">Commerce physique</button>
                    <button onclick="filterType('ECOMMERCE')" id="type-chip-ecommerce" class="type-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-indigo-400 hover:text-indigo-700 transition-colors">Boutique en ligne</button>
                </div>
                <div class="flex items-center gap-2 overflow-x-auto pb-0.5 scrollbar-hide">
                    <span class="text-xs text-slate-400 font-medium whitespace-nowrap">Genre :</span>
                    <button onclick="filterGenre('')" id="genre-chip-tous" class="genre-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-emerald-600 text-white transition-colors">Tous</button>
                    <button onclick="filterGenre('M')" id="genre-chip-m" class="genre-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-emerald-400 hover:text-emerald-700 transition-colors">Homme</button>
                    <button onclick="filterGenre('F')" id="genre-chip-f" class="genre-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-emerald-400 hover:text-emerald-700 transition-colors">Femme</button>
                </div>
                <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5 scrollbar-hide">
                    <span class="text-xs text-slate-400 font-medium whitespace-nowrap">Pays :</span>
                    <button onclick="filterPays('')" id="pays-chip-tous" class="pays-chip whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium bg-emerald-600 text-white transition-colors">Tous</button>
                    {# Lancement France uniquement — autres pays en réserve, cf. ProfessionalType::pays #}
                    {% for code, flag in {'FR':'🇫🇷'} %}
                        <button onclick="filterPays('{{ code }}')" id="pays-chip-{{ code }}"
                                class="pays-chip whitespace-nowrap px-3 py-1 rounded-full text-sm bg-white border border-slate-200 hover:border-emerald-400 transition-colors">
                            {{ flag }}
                        </button>
                    {% endfor %}
                </div>
                <select id="sort-select" class="w-full sm:w-auto border border-slate-200 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-200 text-slate-600 bg-white whitespace-nowrap">
                    <option value="createdAt">Plus récents</option>
                    <option value="starsAverage">Mieux notés</option>
                    <option value="nomSociete">Nom A→Z</option>
                    <option value="ville">Ville A→Z</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div id="results-count" class="text-sm font-medium text-slate-600 mb-5 hidden"></div>

    <div id="results-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        <div class="col-span-full text-center py-20">
            <div class="w-16 h-16 border-4 border-emerald-200 border-t-emerald-600 rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-slate-400">Chargement…</p>
        </div>
    </div>

    <div id="load-more-wrap" class="hidden text-center mt-8">
        <button id="load-more-btn" type="button" class="bg-white border border-emerald-200 text-emerald-700 hover:bg-emerald-50 font-semibold px-6 py-2.5 rounded-xl transition-colors">
            Voir plus de résultats
        </button>
    </div>

    <div id="empty-state" class="hidden text-center py-20">
        <div class="text-5xl mb-4">🔍</div>
        <h3 class="font-serif text-xl font-bold text-emerald-900 mb-2">Aucun résultat trouvé</h3>
        <p class="text-slate-500 mb-6">Essayez avec d'autres mots-clés ou une autre ville.</p>
        <button onclick="resetSearch()" class="bg-emerald-600 text-white px-6 py-2.5 rounded-xl hover:bg-emerald-700 transition-colors">
            Réinitialiser la recherche
        </button>
    </div>
</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        var currentDomaine = '{{ domaine|e('js') }}';
        var currentGenre = '';
        var currentType = '';
        var currentPays = '';
        var countryFlags = { FR:'🇫🇷', BE:'🇧🇪', CA:'🇨🇦', CH:'🇨🇭', LU:'🇱🇺', MA:'🇲🇦', DZ:'🇩🇿', TN:'🇹🇳', LB:'🇱🇧' };
        var searchUrl = '{{ path("api_search") }}';
        var suggestUrl = '{{ path("api_suggestions") }}';
        var acTimer = null;
        var currentPage = 1;
        var hasMoreResults = false;
        // La barre desktop et les cartes empilées mobile sont deux jeux de champs distincts
        // dans le DOM (l'un des deux est caché en CSS selon la largeur d'écran) : on les
        // garde synchronisés pour que doSearch() (qui ne lit que les champs desktop) reflète
        // toujours ce que l'utilisateur a tapé, qu'il soit sur mobile ou desktop.
        var Q_FIELDS = ['search-q', 'search-q-mobile'];
        var VILLE_FIELDS = ['search-ville', 'search-ville-mobile'];

        function setFieldGroup(ids, value) {
            ids.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.value = value;
            });
        }

        function getStars(avg) {
            var html = '<div class="flex items-center gap-0.5">';
            for (var i = 1; i <= 5; i++) {
                var cls = i <= Math.round(avg) ? 'text-amber-400' : 'text-slate-200';
                html += '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 ' + cls + '" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
            }
            html += '</div>';
            return html;
        }

        function renderCard(p) {
            return p.type === 'ECOMMERCE' ? renderEcommerceCard(p) : renderPhysiqueCard(p);
        }

        var mapSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>';
        var shareSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>';
        var pinSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>';

        function renderPhysiqueCard(p) {
            var colors = ['059669','0d9488','0891b2','65a30d','ca8a04'];
            var bg = colors[p.id % 5];
            var mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(p.nomSociete + ' ' + p.ville);
            return '<div class="pro-card bg-white rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col border border-slate-100">' +
                '<div class="h-1.5 bg-gradient-to-r from-emerald-500 to-teal-400"></div>' +
                '<div class="p-5 flex-1">' +
                '<div class="flex items-start gap-3 mb-4">' +
                (p.imageName
                    ? '<img src="/uploads/professionals/' + p.imageName + '" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0 ring-2 ring-emerald-100">'
                    : '<div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-base flex-shrink-0 ring-2 ring-white shadow-md" style="background:linear-gradient(135deg,#' + bg + ',#059669)">' + p.initials + '</div>') +
                '<div class="flex-1 min-w-0">' +
                '<h3 class="font-bold text-slate-800 text-sm leading-snug truncate">' + escHtml(p.nomSociete) + '</h3>' +
                '<p class="text-xs text-slate-500 truncate mt-0.5">' + escHtml(p.profession || p.domaineActivite) + '</p>' +
                '<div class="flex items-center gap-1.5 mt-1.5">' + getStars(p.starsAverage) + '<span class="text-xs font-medium text-slate-700">' + p.starsAverage.toFixed(1) + '</span><span class="text-xs text-slate-400">(' + p.totalAvis + ' avis)</span></div>' +
                '</div></div>' +
                '<div class="space-y-1.5 text-xs text-slate-600 mb-3">' +
                '<div class="flex items-center gap-1.5">' + pinSvg + (countryFlags[p.pays] || '') + ' <span class="font-medium">' + escHtml(p.ville) + '</span><span class="text-slate-400">— ' + escHtml(p.codePostal) + '</span></div>' +
                '<div class="font-mono text-slate-400 text-xs">SIRET ' + escHtml(p.siretFormatted) + '</div>' +
                '</div>' +
                (p.domaineActivite ? '<span class="inline-block bg-emerald-50 text-emerald-700 text-xs px-2.5 py-0.5 rounded-full border border-emerald-100 font-medium">' + escHtml(p.domaineActivite) + '</span>' : '') +
                '</div>' +
                '<div class="px-5 pb-4 pt-3 flex gap-2 border-t border-slate-50">' +
                '<a href="' + p.url + '" class="flex-1 text-center bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-2.5 rounded-xl transition-colors">Voir la fiche</a>' +
                '<a href="' + mapsUrl + '" target="_blank" class="px-3 py-2.5 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50 text-slate-400 hover:text-emerald-600 transition-colors" title="Itinéraire">' + mapSvg + '</a>' +
                '<button onclick="shareCard(\'' + encodeURIComponent(p.nomSociete) + '\',\'' + p.url + '\')" class="px-3 py-2.5 rounded-xl border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50 text-slate-400 hover:text-emerald-600 transition-colors" title="Partager">' + shareSvg + '</button>' +
                '</div></div>';
        }

        function renderEcommerceCard(p) {
            var colors = ['6366f1','8b5cf6','7c3aed','a21caf'];
            var bg = colors[p.id % 4];
            var cartSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>';
            return '<div class="pro-card bg-white rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col border border-slate-100">' +
                '<div class="h-1.5 bg-gradient-to-r from-indigo-500 to-purple-400"></div>' +
                '<div class="p-5 flex-1">' +
                '<div class="flex items-start gap-3 mb-4">' +
                (p.imageName
                    ? '<img src="/uploads/professionals/' + p.imageName + '" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0 ring-2 ring-indigo-100">'
                    : '<div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-base flex-shrink-0 ring-2 ring-white shadow-md" style="background:linear-gradient(135deg,#' + bg + ',#6366f1)">' + p.initials + '</div>') +
                '<div class="flex-1 min-w-0">' +
                '<h3 class="font-bold text-slate-800 text-sm leading-snug truncate">' + escHtml(p.nomSociete) + '</h3>' +
                '<p class="text-xs text-slate-500 truncate mt-0.5">' + escHtml(p.domaineActivite) + '</p>' +
                '<div class="flex items-center gap-1.5 mt-1.5">' + getStars(p.starsAverage) + '<span class="text-xs font-medium text-slate-700">' + p.starsAverage.toFixed(1) + '</span><span class="text-xs text-slate-400">(' + p.totalAvis + ' avis)</span></div>' +
                '</div></div>' +
                '<span class="inline-flex items-center gap-1.5 bg-indigo-50 text-indigo-700 text-xs font-medium px-2.5 py-1 rounded-full border border-indigo-100">' + cartSvg + ' Boutique en ligne</span>' +
                '</div>' +
                '<div class="px-5 pb-4 pt-3 flex gap-2 border-t border-slate-50">' +
                '<a href="' + p.url + '" class="flex-1 text-center bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold py-2.5 rounded-xl transition-colors border border-slate-200">Voir la fiche</a>' +
                (p.siteEcommerce ? '<a href="' + escHtml(p.siteEcommerce) + '" target="_blank" rel="noopener" class="flex-1 text-center bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2.5 rounded-xl transition-colors">Visiter →</a>' : '') +
                '<button onclick="shareCard(\'' + encodeURIComponent(p.nomSociete) + '\',\'' + p.url + '\')" class="px-3 py-2.5 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50 text-slate-400 hover:text-indigo-600 transition-colors" title="Partager">' + shareSvg + '</button>' +
                '</div></div>';
        }

        function escHtml(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function shareCard(name, url) {
            var decodedName = decodeURIComponent(name);
            if (navigator.share) {
                navigator.share({ title: decodedName, url: url });
            } else {
                navigator.clipboard.writeText(url).then(function() {
                    showToast('Lien copié !');
                });
            }
        }

        function showToast(msg) {
            var t = document.createElement('div');
            t.className = 'fixed bottom-4 right-4 z-50 bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm shadow-lg';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function() { t.remove(); }, 2500);
        }

        function filterGenre(g) {
            currentGenre = g;
            document.querySelectorAll('.genre-chip').forEach(function(btn) {
                btn.classList.remove('bg-emerald-600', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-emerald-200');
            });
            var activeId = g === 'M' ? 'genre-chip-m' : g === 'F' ? 'genre-chip-f' : 'genre-chip-tous';
            var active = document.getElementById(activeId);
            if (active) {
                active.classList.add('bg-emerald-600', 'text-white');
                active.classList.remove('bg-white', 'text-slate-700', 'border', 'border-emerald-200');
            }
            doSearch();
        }

        function setupAutocomplete(inputId, dropdownId, field) {
            var input = document.getElementById(inputId);
            var dropdown = document.getElementById(dropdownId);
            if (!input || !dropdown) return;
            var group = field === 'ville' ? VILLE_FIELDS : Q_FIELDS;
            input.addEventListener('input', function() {
                setFieldGroup(group, input.value);
                clearTimeout(acTimer);
                var val = input.value.trim();
                if (val.length < 1) { dropdown.classList.add('hidden'); return; }
                acTimer = setTimeout(function() {
                    var params = new URLSearchParams();
                    params.set(field, val);
                    fetch(suggestUrl + '?' + params.toString())
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            var items = field === 'q' ? (data.professions || []) : (data.villes || []);
                            if (!items.length) { dropdown.classList.add('hidden'); return; }
                            dropdown.innerHTML = '';
                            items.forEach(function(s) {
                                var btn = document.createElement('button');
                                btn.type = 'button';
                                btn.textContent = s;
                                btn.style.cssText = 'display:block;width:100%;padding:0.5rem 1rem;text-align:left;font-size:0.875rem;color:#1e293b;background:none;border:none;border-bottom:1px solid #f0fdf4;cursor:pointer;font-family:inherit;';
                                btn.addEventListener('mousedown', function(e) {
                                    e.preventDefault();
                                    setFieldGroup(group, field === 'ville' ? s.split(' (')[0] : s);
                                    dropdown.classList.add('hidden');
                                    doSearch();
                                });
                                btn.addEventListener('mouseenter', function() { btn.style.background = '#ecfdf5'; btn.style.color = '#059669'; });
                                btn.addEventListener('mouseleave', function() { btn.style.background = 'none'; btn.style.color = '#1e293b'; });
                                dropdown.appendChild(btn);
                            });
                            dropdown.classList.remove('hidden');
                        })
                        .catch(function() { dropdown.classList.add('hidden'); });
                }, 250);
            });
            input.addEventListener('blur', function() {
                setTimeout(function() { dropdown.classList.add('hidden'); }, 200);
            });
        }

        function filterType(t) {
            currentType = t;
            document.querySelectorAll('.type-chip').forEach(function(btn) {
                btn.classList.remove('bg-emerald-600', 'bg-indigo-600', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });
            var activeId = t === 'PHYSIQUE' ? 'type-chip-physique' : t === 'ECOMMERCE' ? 'type-chip-ecommerce' : 'type-chip-tous';
            var active = document.getElementById(activeId);
            if (active) {
                var color = t === 'ECOMMERCE' ? 'bg-indigo-600' : 'bg-emerald-600';
                active.classList.add(color, 'text-white');
                active.classList.remove('bg-white', 'text-slate-700');
            }
            doSearch();
        }

        function gridColsClass(count) {
            if (count <= 1) return 'grid-cols-1';
            if (count === 2) return 'grid-cols-1 sm:grid-cols-2';
            if (count === 3) return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
            return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4';
        }

        function doSearch(append) {
            var q = document.getElementById('search-q').value;
            var ville = document.getElementById('search-ville').value;
            var sort = document.getElementById('sort-select').value;
            currentPage = append ? currentPage + 1 : 1;
            var params = new URLSearchParams({ q: q, ville: ville, domaine: currentDomaine, genre: currentGenre, type: currentType, pays: currentPays, tri: sort, page: currentPage });
            var container = document.getElementById('results-container');
            var empty = document.getElementById('empty-state');
            var count = document.getElementById('results-count');
            var loadMoreWrap = document.getElementById('load-more-wrap');
            var loadMoreBtn = document.getElementById('load-more-btn');

            if (append) {
                loadMoreBtn.disabled = true;
                loadMoreBtn.textContent = 'Chargement…';
            } else {
                container.innerHTML = '<div class="col-span-full text-center py-20"><div class="w-10 h-10 border-4 border-emerald-200 border-t-emerald-600 rounded-full animate-spin mx-auto"></div></div>';
                empty.classList.add('hidden');
                loadMoreWrap.classList.add('hidden');
            }

            fetch(searchUrl + '?' + params.toString())
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var results = data.results || [];
                    var total = data.total || 0;
                    hasMoreResults = !!data.hasMore;
                    var label = currentType === 'ECOMMERCE' ? 'boutique' : 'professionnel';
                    var labelPlural = currentType === 'ECOMMERCE' ? 'boutiques' : 'professionnels';
                    count.textContent = total + ' ' + (total > 1 ? labelPlural : label) + ' trouvé' + (total > 1 ? 's' : '');
                    count.classList.remove('hidden');

                    if (total === 0) {
                        container.innerHTML = '';
                        empty.classList.remove('hidden');
                        loadMoreWrap.classList.add('hidden');
                        return;
                    }

                    var cardsHtml = results.map(function(p, i) {
                        return '<div class="w-full max-w-md" style="animation:fadeInUp .3s ease both;animation-delay:' + (i * 30) + 'ms">' + renderCard(p) + '</div>';
                    }).join('');

                    if (append) {
                        container.insertAdjacentHTML('beforeend', cardsHtml);
                    } else {
                        // Le nombre de colonnes s'adapte au nombre de résultats de la page : avec un
                        // seul résultat par ex., pas la peine de réserver 4 colonnes vides.
                        container.className = 'grid gap-5 ' + gridColsClass(results.length);
                        container.innerHTML = cardsHtml;
                    }

                    loadMoreBtn.disabled = false;
                    loadMoreBtn.textContent = 'Voir plus de résultats';
                    loadMoreWrap.classList.toggle('hidden', !hasMoreResults);
                })
                .catch(function() {
                    if (!append) container.innerHTML = '<div class="col-span-full text-center py-10 text-red-500">Erreur lors de la recherche.</div>';
                    loadMoreBtn.disabled = false;
                    loadMoreBtn.textContent = 'Voir plus de résultats';
                });
        }

        function filterPays(code) {
            currentPays = code;
            // Sync desktop select bar
            var bar = document.getElementById('pays-select-bar');
            if (bar) bar.value = code;
            // Sync mobile select bar
            var barMobile = document.getElementById('pays-select-bar-mobile');
            if (barMobile) barMobile.value = code;
            // Sync chips
            document.querySelectorAll('.pays-chip').forEach(function(btn) {
                btn.classList.remove('bg-emerald-600', 'text-white');
                btn.classList.add('bg-white', 'border', 'border-slate-200');
            });
            var activeId = code ? 'pays-chip-' + code : 'pays-chip-tous';
            var active = document.getElementById(activeId);
            if (active) {
                active.classList.add('bg-emerald-600', 'text-white');
                active.classList.remove('bg-white', 'border', 'border-slate-200');
            }
            doSearch();
        }

        function filterDomaine(d) {
            currentDomaine = d;
            document.querySelectorAll('.domaine-chip').forEach(function(btn) {
                btn.classList.remove('bg-emerald-600','text-white');
                btn.classList.add('bg-white','text-slate-700','border','border-emerald-200');
            });
            event.target.classList.add('bg-emerald-600','text-white');
            event.target.classList.remove('bg-white','text-slate-700','border','border-emerald-200');
            doSearch();
        }

        function resetSearch() {
            setFieldGroup(Q_FIELDS, '');
            setFieldGroup(VILLE_FIELDS, '');
            currentDomaine = '';
            doSearch();
        }

        document.getElementById('sort-select').addEventListener('change', function() { doSearch(); });
        document.getElementById('search-form').addEventListener('submit', function(e) {
            e.preventDefault();
            doSearch();
        });
        document.getElementById('load-more-btn').addEventListener('click', function() {
            doSearch(true);
        });
        document.getElementById('gps-btn').addEventListener('click', function() {
            if (!navigator.geolocation) return;
            var btn = this;
            btn.classList.add('animate-spin');
            navigator.geolocation.getCurrentPosition(function(pos) {
                fetch('https://nominatim.openstreetmap.org/reverse?lat=' + pos.coords.latitude + '&lon=' + pos.coords.longitude + '&format=json&accept-language=fr')
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        btn.classList.remove('animate-spin');
                        var cp = d.address.postcode || '';
                        var city = d.address.city || d.address.town || d.address.village || '';
                        setFieldGroup(VILLE_FIELDS, cp || city);
                        doSearch();
                    });
            }, function() { btn.classList.remove('animate-spin'); });
        });

        function detectCountry() {
            var supported = ['FR','BE','CA','CH','LU','MA','DZ','TN','LB'];

            // 1. navigator.language → ex: "fr-BE", "fr-CA", "ar-MA"
            var lang = (navigator.language || '').toUpperCase();
            var code = lang.split('-')[1] || '';
            if (supported.includes(code)) return code;

            // 2. Fuseau horaire → ex: "Europe/Brussels", "Africa/Algiers"
            var tzMap = {
                'Europe/Paris':'FR', 'Europe/Brussels':'BE',
                'America/Toronto':'CA','America/Montreal':'CA','America/Vancouver':'CA','America/Winnipeg':'CA',
                'Europe/Zurich':'CH', 'Europe/Luxembourg':'LU',
                'Africa/Casablanca':'MA','Africa/Algiers':'DZ',
                'Africa/Tunis':'TN','Asia/Beirut':'LB'
            };
            var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
            return tzMap[tz] || '';
        }

        // Auto-search on load + autocomplete
        document.addEventListener('DOMContentLoaded', function() {
            setupAutocomplete('search-q', 'search-q-dropdown', 'q');
            setupAutocomplete('search-ville', 'search-ville-dropdown', 'ville');
            setupAutocomplete('search-q-mobile', 'search-q-mobile-dropdown', 'q');
            setupAutocomplete('search-ville-mobile', 'search-ville-mobile-dropdown', 'ville');

            // Sync desktop select bar → filtre
            var bar = document.getElementById('pays-select-bar');
            if (bar) {
                bar.addEventListener('change', function() { filterPays(this.value); });
            }

            // Sync mobile select bar → filtre
            var barMobile = document.getElementById('pays-select-bar-mobile');
            if (barMobile) {
                barMobile.addEventListener('change', function() { filterPays(this.value); });
            }

            // GPS button mobile
            var gpsMobile = document.getElementById('gps-btn-mobile');
            if (gpsMobile) {
                gpsMobile.addEventListener('click', function() {
                    if (!navigator.geolocation) return;
                    var btn = this;
                    btn.classList.add('animate-spin');
                    navigator.geolocation.getCurrentPosition(function(pos) {
                        fetch('https://nominatim.openstreetmap.org/reverse?lat=' + pos.coords.latitude + '&lon=' + pos.coords.longitude + '&format=json&accept-language=fr')
                            .then(function(r) { return r.json(); })
                            .then(function(d) {
                                btn.classList.remove('animate-spin');
                                var cp = d.address.postcode || '';
                                var city = d.address.city || d.address.town || d.address.village || '';
                                setFieldGroup(VILLE_FIELDS, cp || city);
                                doSearch();
                            });
                    }, function() { btn.classList.remove('animate-spin'); });
                });
            }

            // Pré-sélection par détection navigateur
            var detected = '{{ app.request.query.get("pays")|e("js") }}' || detectCountry();
            if (detected) filterPays(detected);
            else doSearch();
        });
    </script>
{% endblock %}
